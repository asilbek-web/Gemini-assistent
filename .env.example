# Local development only. Railway does not read this file; set the same
# names as Variables in the Railway service instead.
#
#   cp .env.example .env && chmod 600 .env

# Bot token from @BotFather (/newbot). Required.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram ID (ask @userinfobot). Only this account is served.
OWNER_ID=

# false: replies are logged as PREVIEW, never sent. Flip to true when the
# previews look good.
AUTO_SEND=false

# FREE engine: Google Gemini API key from aistudio.google.com/apikey
# ("Create API key", no card needed). When set, Gemini is used and the
# Claude CLI below is ignored.
GEMINI_API_KEY=
# Gemini model; empty uses gemini-2.5-flash (free tier).
GEMINI_MODEL=

# OPTIONAL engine: result of `claude setup-token` (starts with sk-ant-oat),
# valid one year, only used when GEMINI_API_KEY is empty. Store it like a
# password and paste it on a single line with an editor, never with echo.
# Leave empty to use this machine's own claude login (local testing only).
CLAUDE_CODE_OAUTH_TOKEN=

# Optional Claude CLI tuning. Usually leave empty.
# Model alias or full name; empty uses the CLI default.
CLAUDE_MODEL=
# Effort level: low, medium, high, xhigh, max.
CLAUDE_EFFORT=low
# Per-reply timeout in seconds (minimum 1).
CLAUDE_TIMEOUT_SECONDS=120

# Cooldown in minutes after the subscription limit is hit (minimum 1).
LIMIT_COOLDOWN_MINUTES=30
# Minutes the bot stays quiet in a chat after the owner writes there
# (0 disables).
OWNER_TAKEOVER_MINUTES=15
# Rolling history entries kept per chat (minimum 1).
HISTORY_LIMIT=30
